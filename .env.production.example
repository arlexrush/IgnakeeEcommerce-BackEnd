# PostgreSQL/Compose Production
# Replace every replace-with-* value locally; never commit the resulting .env file.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-a-managed-production-secret
POSTGRES_PORT=5432
API_PORT=8080
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=replace-with-admin-email
PGADMIN_DEFAULT_PASSWORD=replace-with-managed-pgadmin-secret
ConnectionStrings__PostgresConnection=Host=postgres;Port=5432;Database=ecommerce;Username=ecommerce;Password=replace-with-a-managed-production-secret

# JWT
JwtSettings__Key=replace-with-a-long-random-production-signing-key
JwtSettings__Issuer=EcommerceCEO
JwtSettings__Audience=EcommerceUsers
JwtSettings__DurationInMinutes=60
JwtSettings__ExpireTime=72:10:30

# Email
EmailSettings__Email=replace-with-production-email
EmailSettings__AppAPIKey=replace-with-production-sendgrid-key
EmailSettings__BaseUrlClient=https://replace-with-production-client-url

# Cloudinary
CloudinarySettings__CloudName=replace-with-production-cloud-name
CloudinarySettings__ApiKey=replace-with-production-cloudinary-key
CloudinarySettings__ApiSecret=replace-with-production-cloudinary-secret

# Google external authentication
Authentication__Google__ClientId=replace-with-google-client-id
Authentication__Google__ClientSecret=replace-with-google-client-secret
Authentication__Google__CallbackPath=/signin-google
Authentication__PublicBaseUrl=https://api.midominio.com
# Set to the actual reverse-proxy IP when TLS/host headers are forwarded
# ForwardedHeaders__KnownProxies=127.0.0.1

# Stripe
StripeSettings__Publishablekey=pk_live_replace-me
StripeSettings__Secretkey=sk_live_replace-me
StripeSettings__WebhookSecret=whsec_replace-me

# Shipping providers
CorreosSettings__CertificadoDigital=replace-with-production-certificate
GlovoSettings__GlovoApiKey=replace-with-production-glovo-key
GlovoSettings__StoreId=replace-with-production-store-id
GlovoSettings__UrlPath=https://api.glovoapp.com
DHLSettings__ApiUrl=replace-with-production-dhl-endpoint
DHLSettings__ApiKey=replace-with-production-dhl-key
DHLSettings__ApiSecret=replace-with-production-dhl-secret
MRWSettings__ApiUrl=https://api.mrw.es/shipments
MRWSettings__Usuario=replace-with-production-mrw-user
MRWSettings__Contraseña=replace-with-production-mrw-password
MRWSettings__ApiKey=replace-with-production-mrw-key
MRWSettings__NIF=replace-with-production-mrw-nif
