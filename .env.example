# Docker/PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_PORT=5432
GATEWAY_PORT=5000
ConnectionStrings__PostgresConnection=Host=postgres;Port=5432;Database=ecommerce;Username=postgres;Password=replace-with-local-database-password
ConnectionStrings__ConnectionString=Host=localhost;Port=5432;Database=ecommerce;Username=postgres;Password=replace-with-local-database-password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-local-pgadmin-password
PGADMIN_PORT=5050

# Email
EmailSettings__Email=your-email@example.com
EmailSettings__AppAPIKey=replace-with-sendgrid-api-key
EmailSettings__BaseUrlClient=http://localhost:3000

# Cloudinary
CloudinarySettings__CloudName=replace-with-cloudinary-cloud-name
CloudinarySettings__ApiKey=replace-with-cloudinary-api-key
CloudinarySettings__ApiSecret=replace-with-cloudinary-api-secret

# JWT
JwtSettings__Key=replace-with-a-long-random-signing-key
JwtSettings__Issuer=EcommerceCEO
JwtSettings__Audience=EcommerceUsers
JwtSettings__DurationInMinutes=60
JwtSettings__ExpireTime=72:10:30

# Google external authentication
Authentication__Google__ClientId=replace-with-google-client-id
Authentication__Google__ClientSecret=replace-with-google-client-secret
Authentication__Google__CallbackPath=/signin-google
Authentication__PublicBaseUrl=http://localhost:5000
# Comma-separated IP addresses of trusted reverse proxies, when applicable
# ForwardedHeaders__KnownProxies=127.0.0.1

# Stripe
StripeSettings__Publishablekey=pk_test_replace-me
StripeSettings__Secretkey=sk_test_replace-me
StripeSettings__WebhookSecret=whsec_replace-me

# Shipping providers
CorreosSettings__CertificadoDigital=replace-with-certificate-value
GlovoSettings__GlovoApiKey=replace-with-glovo-api-key
GlovoSettings__StoreId=replace-with-glovo-store-id
GlovoSettings__UrlPath=https://stageapi.glovoapp.com
DHLSettings__ApiUrl=https://replace-with-dhl-endpoint
DHLSettings__ApiKey=replace-with-dhl-api-key
DHLSettings__ApiSecret=replace-with-dhl-api-secret
MRWSettings__ApiUrl=https://api.mrw.es/shipments
MRWSettings__Usuario=replace-with-mrw-user
MRWSettings__Contraseña=replace-with-mrw-password
MRWSettings__ApiKey=replace-with-mrw-api-key
MRWSettings__NIF=replace-with-mrw-nif